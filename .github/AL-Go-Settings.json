{
  "$schema": "https://raw.githubusercontent.com/y0m0/AL-Go/feature/workflow_call/Actions/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/y0m0/AL-Go@feature/workflow_call",
  "runs-on": "ubuntu-latest",
  "enableCodeCop": true,
  "enableUICop": true,
  "enablePerTenantExtensionCop": true,
  "cacheKeepDays": 8,
  "artifact": "////weekly",
  "customCodeCops": [],
  "versioningStrategy": 3,
  "overwriteSettings": [
    "CICDPullRequestBranches",
    "CICDPushBranches"
  ],
  "CICDPullRequestBranches": [
    "__disabled__"
  ],
  "CICDPushBranches": [
    "__disabled__"
  ],
  "doNotBuildTests": true,
  "doNotRunTests": true,
  "doNotRunPageScriptingTests": true,
  "doNotRunBcptTests": true,
  "ConditionalSettings": [
    {
      "branches": [
        "*"
      ],
      "settings": {
        "useCompilerFolder": true,
        "doNotPublishApps": true,
        "doNotSignApps": true
      }
    },
    {
      "branches": [
        "main",
        "master",
        "release/*"
      ],
      "settings": {
        "doNotPublishApps": false
      }
    },
    {
      "workflows": [
        "Update AL-Go System Files"
      ],
      "settings": {
        "commitOptions": {
          "messageSuffix": "[skip ci]",
          "createPullRequest": false
        },
        "workflowSchedule": {
          "cron": "1 1 * * SAT",
          "includeBranches": [
            "develop"
          ]
        }
      }
    },
    {
      "workflows": [
        "Create Release"
      ],
      "settings": {
        "workflowDefaultInputs": [
          {
            "name": "releaseType",
            "value": "Release"
          },
          {
            "name": "updateVersionNumber",
            "value": "+0.0.1"
          },
          {
            "name": "directCommit",
            "value": false
          },
          {
            "name": "useGhTokenWorkflow",
            "value": true
          }
        ]
      }
    }
  ],
  "templateSha": "c389f2ed380cd5d18057f7eda73ec1ecb75a70cd"
}
